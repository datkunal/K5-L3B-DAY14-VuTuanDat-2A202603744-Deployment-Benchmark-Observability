# ============================================================
# Biến môi trường của agent Part 6 (tiêu chí 9). KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env  rồi sửa .env (file .env đã nằm trong .gitignore)
# ============================================================

# --- Server ---
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
# Số worker uvicorn trong Docker
WEB_CONCURRENCY=2

# --- Bảo mật (secret) ---
# Tạo key ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=change-me

# --- Redis (state của rate limit + cost guard) ---
# docker compose tự đặt redis://redis:6379/0; chạy local ngoài Docker thì dùng localhost
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=1

# --- Giới hạn ---
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
